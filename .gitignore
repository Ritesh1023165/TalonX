# ------------------------------------------------------------------
# Secrets -- never commit real API keys/tokens
# ------------------------------------------------------------------
.env
*.env
!.env.example

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ------------------------------------------------------------------
# Virtual environment
# ------------------------------------------------------------------
.venv/
venv/

# ------------------------------------------------------------------
# Local runtime state (SQLite DBs, ChromaDB persist dir, raw filing
# cache) -- these default to %USERPROFILE%\.talonx outside the repo,
# but ignored here too in case anyone points a path inside it.
# ------------------------------------------------------------------
*.db
*.sqlite3
.talonx/
chroma/

# generate_eod_report.py's default output -- generated locally, not
# something to version.
reports/

# talonx_backtest's default --out directory -- generated report output,
# not something to version (examples/data/ IS versioned -- that's the
# checked-in sample INPUT, not generated output).
/results/

# scripts/download_historical_1m.py's default --output-dir -- downloaded
# real market data, not something to version (large, regenerable,
# provider-licensed). Same "examples/data/ IS versioned, this isn't"
# distinction as /results/ above.
/data/

# scripts/start_talonx.ps1 / start_dashboard_web.ps1's PID-tracking JSON
# and redirected stdout/stderr log files -- machine-local runtime state.
.run/

# Task 66A: ad hoc local log/console-capture output (e.g. one-off
# research-script runs redirected to a file) -- generated, machine-local,
# not something to version. Same distinction as reports//results/data/
# above: canonical evidence lives under results/, this is scratch.
/logs/

# ------------------------------------------------------------------
# Claude Code local settings (machine-specific permission allowlist,
# not shared config)
# ------------------------------------------------------------------
.claude/settings.local.json

# ------------------------------------------------------------------
# OS / editor cruft
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
