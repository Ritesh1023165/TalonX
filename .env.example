# Copy this file to .env in this same folder (the repo root) and fill in
# the REQUIRED section. Everything else is optional tuning with sane
# defaults -- see README.md §7 for the full rationale behind each one.

# ------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------
# SEC requires a descriptive User-Agent identifying who is making
# requests. Format: "Name/Company contact@email.com". Missing or
# generic values will get you 403'd or throttled harder.
TALONX_SEC_USER_AGENT="Your Name Your Company your.email@example.com"

# ------------------------------------------------------------------
# OPTIONAL -- EDGAR rate limiting / retry tuning
# ------------------------------------------------------------------
# TALONX_SEC_RPS=8.0
# TALONX_SEC_CONCURRENCY=4
# TALONX_SEC_MAX_RETRIES=5
# TALONX_SEC_BACKOFF_BASE=1.5
# TALONX_SEC_BACKOFF_MAX=60.0
# TALONX_SEC_TIMEOUT=30.0
# TALONX_SEC_LOOKBACK=4

# ------------------------------------------------------------------
# OPTIONAL -- chunking
# ------------------------------------------------------------------
# TALONX_CHUNK_SIZE=1800
# TALONX_CHUNK_OVERLAP=250
# TALONX_MIN_CHUNK_CHARS=40

# ------------------------------------------------------------------
# OPTIONAL -- vector store / embeddings
# ------------------------------------------------------------------
# TALONX_CHROMA_DIR=C:\Users\you\.talonx\chroma
# TALONX_CHROMA_COLLECTION=sec_filings
# TALONX_EMBEDDING_MODEL=all-MiniLM-L6-v2
# TALONX_CHROMA_BATCH_SIZE=128

# ------------------------------------------------------------------
# OPTIONAL -- raw filing cache / ledger
# ------------------------------------------------------------------
# TALONX_RAW_CACHE_DIR=C:\Users\you\.talonx\raw_filings
# TALONX_LEDGER_PATH=C:\Users\you\.talonx\ledger.db

# ------------------------------------------------------------------
# OPTIONAL -- market data (structured/quant side)
# ------------------------------------------------------------------
# Without this set, market_data automatically uses yfinance polling
# instead of Polygon WebSocket streaming (delayed data, not real-time,
# but requires no account/key).
# POLYGON_API_KEY=your_polygon_io_api_key

# TALONX_POLYGON_WS_URL=wss://socket.polygon.io/stocks
# TALONX_WS_MAX_RECONNECT=8
# TALONX_WS_BACKOFF_BASE=1.0
# TALONX_WS_BACKOFF_MAX=30.0
# TALONX_WS_AUTH_TIMEOUT=10.0
# TALONX_WS_IDLE_TIMEOUT=60.0
# TALONX_YF_POLL_INTERVAL=5.0
# TALONX_YF_MAX_RETRIES=3
# TALONX_YF_BACKOFF_BASE=2.0
# TALONX_YF_BACKOFF_MAX=30.0
# Vectorized Multi-Quote Poller: run_talonx.PreMarketPoller's full-watchlist
# refresh (one batched yf.download() call) logs a WARNING instead of INFO
# once a cycle takes longer than this -- the "50+ tickers in under 30s"
# target, made visible in logs rather than something timed externally.
# TALONX_PREMARKET_REFRESH_WARN_SECONDS=30.0

# ------------------------------------------------------------------
# OPTIONAL -- talonx_quant indicator thresholds
# ------------------------------------------------------------------
# TALONX_QUANT_RSI_PERIOD=14
# TALONX_QUANT_RSI_OVERSOLD=30
# TALONX_QUANT_RSI_OVERBOUGHT=70
# TALONX_QUANT_MACD_FAST=12
# TALONX_QUANT_MACD_SLOW=26
# TALONX_QUANT_MACD_SIGNAL=9
# TALONX_QUANT_MA_FAST=50
# TALONX_QUANT_MA_SLOW=200
# TALONX_QUANT_VOLUME_AVG_PERIOD=20
# TALONX_QUANT_VOLUME_SURGE_RATIO=2.0
# 120, not just macd_slow+macd_signal=35 -- gives MACD's 26-period EMA
# roughly 4-5x its own period to settle before a crossover is trusted
# (an investment-analyst review of live paper trading flagged EMA
# seed-bias as a contributor to early false crossovers).
# TALONX_QUANT_MIN_BARS=120
# TALONX_QUANT_MAX_BARS=500
# TALONX_QUANT_RECONNECT_BASE=1.0
# TALONX_QUANT_RECONNECT_MAX=30.0
# Cooldown/throttle suppression-count persistence, for generate_eod_report.py's
# signal-funnel section (README §5p).
# TALONX_QUANT_ENABLE_PERSISTENCE=true
# TALONX_QUANT_DB_PATH=C:\Users\you\.talonx\quant.db

# Analyst-review signal-quality filters (added after a live paper-trading
# review found a 0.33 profit factor / 25% win rate, with 3 consecutive
# SMCI losses driving 93% of session losses). See talonx_quant/config.py
# for the full rationale behind each default.
# TALONX_QUANT_ATR_PERIOD=14
# A candidate signal's own bar must move at least this many multiples of
# ATR to count as a real directional move, not routine noise.
# TALONX_QUANT_ATR_MOVE_MULTIPLIER=1.0
# Minimum bar-level confluence score (0-3: MACD cross + RSI extreme +
# volume surge) required before a candidate survives past strategy.py.
# TALONX_QUANT_CONFLUENCE_SCORE_MIN=2
# Structural R:R filter: reward is measured to the nearest classic
# floor-trader pivot level (prior completed regular session's R1/S1, see
# indicators.compute_daily_pivots) rather than a second ATR multiple --
# a genuine market-derived target, not a fixed configuration ratio.
# TALONX_QUANT_PIVOT_STOP_ATR_MULTIPLIER=1.5
# TALONX_QUANT_MIN_RISK_REWARD_RATIO=1.5
# Fallback dollar stop/target (used for stop_price always, and for
# target_price only while a candidate's prior-session pivot data is still
# warming up).
# TALONX_QUANT_ATR_STOP_MULTIPLIER=1.0
# TALONX_QUANT_ATR_REWARD_MULTIPLIER=1.5
# TALONX_QUANT_ASSUMED_STOP_LOSS_PCT=0.005
# Post-loss lockout: on a paper-trading SELL that closes at a loss, that
# ticker is locked out for this many seconds -- LONGER than, and on top
# of, the standard cooldown above -- to stop repeat re-entries into a
# stock that just proved it was chopping/declining. 75 min default (the
# middle of the analyst review's suggested 60-90 min range).
# TALONX_QUANT_LOSS_LOCKOUT_SECONDS=4500.0

# Minimum volatility gate (2026-08-14 session review: a low-beta REIT
# took up an intraday execution slot without enough range to ever reach
# an ATR-scaled stop/target). ATR14/price, as a percentage, must clear
# this before a bar's momentum indicators are even evaluated.
# TALONX_QUANT_MIN_ATR_PCT=0.25

# Session entry blackout windows (same review: a late-session BUY stopped
# out 33 seconds later on institutional order-book rebalancing). Opening
# (09:30-09:45 ET) suppresses ALL new signals; closing (15:30-16:00 ET)
# suppresses new BULLISH entries only, letting a genuine bearish/exit
# signal still fire before the EOD-flatten sweep above closes the
# position anyway. Window boundaries are fixed constants in
# talonx_quant/session.py (see get_entry_blackout), not env-configurable
# -- same treatment the pre-market/regular boundary already gets there.

# Bar buffer persistence -- periodic checkpoint of both RollingBarBuffers
# to quant.db so a restart doesn't force a full re-warm-up. See
# docs/bar_buffer_persistence.md.
# TALONX_QUANT_BUFFER_CHECKPOINT_SECONDS=60.0
# TALONX_QUANT_BUFFER_RELOAD_MAX_GAP_SECONDS=900.0

# 15-min 200-SMA higher-timeframe trend gate.
# TALONX_QUANT_HTF_BAR_INTERVAL_MINUTES=15
# TALONX_QUANT_HTF_SMA_PERIOD=200
# TALONX_QUANT_HTF_MAX_BARS=210
# TALONX_QUANT_TREND_GATE_ENABLED=true

# Historical pre-seeding (Requirement 2): backfills both buffers via
# yfinance the moment a ticker is first seen (or has too little
# checkpointed/reloaded history), eliminating the ~24min (1-min buffer)
# and ~50-continuous-hour (15-min HTF buffer) live-only warm-up. See
# docs/bar_buffer_persistence.md.
# TALONX_QUANT_PRESEED_ENABLED=true
# TALONX_QUANT_PRESEED_1M_PERIOD=1d
# TALONX_QUANT_PRESEED_15M_PERIOD=1mo
# Requirement 4: on top of the HTF buffer's unconditional reload, a
# checkpoint gap this large (e.g. a weekend) also triggers a yfinance
# backfill of whatever's missing since then.
# TALONX_QUANT_HTF_BACKFILL_GAP_SECONDS=86400.0

# Session-aware buffering (Requirement 3): restrict the 15m-200-SMA
# trend gate's source buffer to Regular Trading Hours bars only --
# pre-market 15-min candles are never finalized into it.
# TALONX_QUANT_RTH_ONLY_HTF=true

# ------------------------------------------------------------------
# OPTIONAL -- Redis Pub/Sub (event publishing + inter-module wire contract)
# ------------------------------------------------------------------
# Without Redis reachable, ingestion and streaming still work normally --
# only the live event broadcast is disabled (logged once, not fatal).
TALONX_REDIS_URL=redis://localhost:6379/0
# TALONX_REDIS_MARKET_CHANNEL=talonx:market:stream
# TALONX_REDIS_FILINGS_CHANNEL=talonx:filings:events
# TALONX_REDIS_SIGNALS_CHANNEL=talonx:signals:quant
# TALONX_REDIS_REPORTS_CHANNEL=talonx:reports:brain
# TALONX_REDIS_ALERTS_CHANNEL=talonx:alerts:dispatch
# Rejection Trace Logging: talonx_quant publishes one RejectedCandidateEvent
# per candidate a gate drops (confluence, structural R:R, trend, etc.);
# talonx_dispatch subscribes purely to persist a durable, per-candidate
# audit trail (store.py's rejected_candidates table).
# TALONX_REDIS_REJECTED_CANDIDATES_CHANNEL=talonx:quant:rejected
# TALONX_REDIS_CONNECT_TIMEOUT=5.0
# TALONX_REDIS_SOCKET_TIMEOUT=5.0

# ------------------------------------------------------------------
# OPTIONAL -- news/social feed ingestion
# ------------------------------------------------------------------
# Without this set, news ingestion automatically uses the Yahoo Finance
# RSS fallback instead of NewsAPI.org (no key required, fewer/less-tunable
# results).
# NEWS_API_KEY=your_newsapi_org_key

# TALONX_NEWS_ARTICLES_PER_TICKER=20
# TALONX_NEWS_LOOKBACK_DAYS=7
# TALONX_NEWS_RSS_TEMPLATE=https://feeds.finance.yahoo.com/rss/2.0/headline?s={symbol}&region=US&lang=en-US
# TALONX_NEWS_MAX_RETRIES=3
# TALONX_NEWS_BACKOFF_BASE=1.5
# TALONX_NEWS_BACKOFF_MAX=30.0
# TALONX_NEWS_TIMEOUT=15.0
# TALONX_NEWS_CHROMA_COLLECTION=news_feed

# Reddit as an additional news/social source (optional -- see README §4
# for how to create a Reddit app; NewsAPI/RSS above already work without it)
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
# REDDIT_USER_AGENT="TalonX Research Engine by /u/your_reddit_username"
# TALONX_REDDIT_SUBREDDITS=stocks,investing,wallstreetbets
# TALONX_REDDIT_POSTS_PER_TICKER=20
# TALONX_REDDIT_LOOKBACK_DAYS=7
# TALONX_REDDIT_RPM=60
# TALONX_REDDIT_MAX_RETRIES=3
# TALONX_REDDIT_BACKOFF_BASE=1.5
# TALONX_REDDIT_BACKOFF_MAX=30.0
# TALONX_REDDIT_TIMEOUT=15.0

# ------------------------------------------------------------------
# talonx_brain (Module 3) -- LLM provider switch (README §3.3, §9.4)
# ------------------------------------------------------------------
# Pick ONE provider:
#
# Option A -- Gemini (default, cloud). Get a key from
# https://aistudio.google.com/apikey. Free tier has both per-minute AND
# per-day quotas that are easy to exhaust under active testing (§9.2).
# GEMINI_API_KEY=your_gemini_api_key
# TALONX_BRAIN_GEMINI_MODEL=gemini-flash-latest
# TALONX_BRAIN_GEMINI_TEMPERATURE=0.2
# TALONX_BRAIN_GEMINI_MAX_TOKENS=2048
# TALONX_BRAIN_GEMINI_MAX_RETRIES=3
# TALONX_BRAIN_GEMINI_BACKOFF_BASE=2.0
# TALONX_BRAIN_GEMINI_BACKOFF_MAX=30.0
# TALONX_BRAIN_GEMINI_RPM=5

# Option B -- Ollama (local, no key/quota). Install from ollama.com,
# `ollama pull llama3.1`, then uncomment:
# TALONX_BRAIN_LLM_PROVIDER=ollama
# TALONX_BRAIN_OLLAMA_BASE_URL=http://localhost:11434
# TALONX_BRAIN_OLLAMA_MODEL=llama3.1
# TALONX_BRAIN_OLLAMA_TEMPERATURE=0.2
# TALONX_BRAIN_OLLAMA_MAX_RETRIES=3
# TALONX_BRAIN_OLLAMA_BACKOFF_BASE=2.0
# TALONX_BRAIN_OLLAMA_BACKOFF_MAX=30.0

# TALONX_BRAIN_RETRIEVAL_TOP_K=6
# TALONX_BRAIN_EXCERPT_MAX_CHARS=600
# TALONX_BRAIN_INCLUDE_NEWS=true
# TALONX_BRAIN_NEWS_TOP_K=3
# TALONX_BRAIN_RECONNECT_BASE=1.0
# TALONX_BRAIN_RECONNECT_MAX=30.0

# Qualitative research caching (README §3.3) -- cuts repeat Gemini/Ollama
# calls for the same ticker. TALONX_REDIS_FILINGS_CHANNEL (already
# defined above under talonx_ingest) is reused here too, no separate var.
# TALONX_BRAIN_CACHE_ENABLED=true
# TALONX_BRAIN_CACHE_BASE_TTL=7200
# TALONX_BRAIN_CACHE_SAFETY_TTL=21600
# TALONX_BRAIN_CACHE_LOCK_TTL=30
# TALONX_BRAIN_CACHE_LOCK_WAIT_SECONDS=20
# TALONX_BRAIN_MARKET_TZ=America/New_York
# TALONX_BRAIN_MARKET_OPEN_HOUR=9
# TALONX_BRAIN_MARKET_CLOSE_HOUR=16

# Report-category (cache_hit/stale_fallback/degraded/cold_start/llm_call)
# persistence, for generate_eod_report.py's LLM/cache economics section (README §5p).
# TALONX_BRAIN_ENABLE_PERSISTENCE=true
# TALONX_BRAIN_DB_PATH=C:\Users\you\.talonx\brain.db

# ------------------------------------------------------------------
# talonx_core (Module 4) -- decision engine tuning
# ------------------------------------------------------------------
# TALONX_CORE_MIN_CONFIDENCE=0.5
# TALONX_CORE_CORRELATION_WINDOW=1800
# TALONX_CORE_TICKER_COOLDOWN=300
# TALONX_CORE_PRICE_DELTA_RETRIGGER_PCT=0.01
# TALONX_CORE_ENABLE_PERSISTENCE=true
# TALONX_CORE_STATE_DB=C:\Users\you\.talonx\core_state.db
# TALONX_CORE_RECONNECT_BASE=1.0
# TALONX_CORE_RECONNECT_MAX=30.0

# ------------------------------------------------------------------
# talonx_dispatch (Module 5) -- Telegram push + Streamlit dashboard
# ------------------------------------------------------------------
# Optional -- without it, alerts are still recorded to the audit trail
# and shown in the Streamlit dashboard, you just don't get a mobile push.
# See README §4 for the @BotFather setup steps.
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# TALONX_DISPATCH_MIN_SEVERITY=warning
# TALONX_DISPATCH_AUDIT_DB=C:\Users\you\.talonx\dispatch_audit.db
# TALONX_DISPATCH_FEED_LIMIT=200
# TALONX_DISPATCH_AUTOREFRESH_MS=5000
# TALONX_DISPATCH_RECONNECT_BASE=1.0
# TALONX_DISPATCH_RECONNECT_MAX=30.0
# TALONX_DISPATCH_TELEGRAM_MAX_RETRIES=3
# TALONX_DISPATCH_TELEGRAM_BACKOFF_BASE=2.0
# TALONX_DISPATCH_TELEGRAM_BACKOFF_MAX=30.0
# TALONX_DISPATCH_TELEGRAM_POLL_TIMEOUT=30.0

# Audit trail retention (README §3.5/§4) -- how long an alert stays
# recorded, and therefore look-up-able by ID via a Telegram reply.
# TALONX_DISPATCH_RETENTION_DAYS=5.0
# TALONX_DISPATCH_RETENTION_SWEEP_HOURS=24.0

# Smart Dispatch Filtering (README §3.5) -- gates the TELEGRAM PUSH only;
# every alert is still recorded to the audit trail / Streamlit dashboard
# 100% of the time regardless of these settings. Added after a live
# session logged 86 pushes in 4.3 hours (~20/hour), 44.8% of them
# non-actionable CONTRADICTED alerts and 40.2% the same ticker re-alerting
# every ~20 minutes on minor price noise.
# Only CONFIRMED_BULLISH/CONFIRMED_BEARISH (intraday) or
# HIGH_CONVICTION_BUY/TAKE_PROFIT_REBALANCE/UNDER_PERFORM_REBALANCE
# (long-term) are push-eligible; set to false to push every action again.
# TALONX_DISPATCH_MUTE_CONTRADICTIONS=true
# Suppress pushes below this research_confidence (intraday only).
# TALONX_DISPATCH_MIN_CONFIDENCE=0.75
# Per-ticker push lockout, separate from and on top of talonx_core's own
# pre-publish cooldown.
# TALONX_DISPATCH_PUSH_COOLDOWN_MINUTES=45.0
# Early bypass of the cooldown above when price has moved at least this
# percent since the last push for that ticker.
# TALONX_DISPATCH_RETRIGGER_PRICE_DELTA_PCT=1.0

# ------------------------------------------------------------------
# Ticker watchlist (talonx_watchlist) -- see README §5n
# ------------------------------------------------------------------
# Which tickers run_talonx.py streams market data for and periodically
# ingests filings/news for. Managed live via the "Tracked tickers"
# section of the Streamlit dashboard (talonx_dispatch/app.py) -- these
# vars only control the store's location and the fresh-install default.
# TALONX_WATCHLIST_DB=C:\Users\you\.talonx\watchlist.db
# TALONX_WATCHLIST_DEFAULT_SYMBOL=MSFT
# TALONX_WATCHLIST_DEFAULT_NAME=Microsoft Corporation
# TALONX_WATCHLIST_DEFAULT_EXCHANGE=NASDAQ
# TALONX_WATCHLIST_POLL_INTERVAL=10.0

# ------------------------------------------------------------------
# talonx_paper (Module 6) -- Live Paper Trading Engine, see README §3.6
# ------------------------------------------------------------------
# Fresh-install defaults only -- once a portfolio has been created, the
# dashboard's Settings panel (starting balance / trade allocation) is the
# live source of truth; these vars don't retroactively change it. Use
# the dashboard's Reset Portfolio button to actually apply a new value.
# TALONX_PAPER_DB=C:\Users\you\.talonx\paper_trading.db
# TALONX_PAPER_INITIAL_BALANCE=10000.0
# TALONX_PAPER_TRADE_ALLOCATION=2500.0
# TALONX_REDIS_PAPER_TRADES_CHANNEL=talonx:paper:trades
# TALONX_PAPER_RECONNECT_BASE=1.0
# TALONX_PAPER_RECONNECT_MAX=30.0

# Risk management + friction realism (README §5o) -- added after a live
# session review found a negative risk-to-reward asymmetry and
# unmodeled friction eating small gains.
# TALONX_PAPER_STOP_LOSS_PCT=0.005
# TALONX_PAPER_TAKE_PROFIT_PCT=0.01
# TALONX_PAPER_SIMULATED_SPREAD_BPS=5.0
# TALONX_PAPER_MIN_ENTRY_SEVERITY=warning

# Automated End-of-Day flattening (2026-08-14 session review: an intraday
# position opened and rode unclosed through market close, with no
# liquidation routine to catch it). Daily sweep at hour_et:minute_et
# America/New_York that closes every still-open INTRADAY position
# (EOD_FLAT_LIQUIDATION) -- the LONG_TERM DCA-aware ledger is explicitly
# out of scope. Time is ET, not UTC, so the target doesn't drift across
# the spring/fall DST transition.
# TALONX_PAPER_EOD_FLATTEN_ENABLED=true
# TALONX_PAPER_EOD_FLATTEN_HOUR_ET=15
# TALONX_PAPER_EOD_FLATTEN_MINUTE_ET=50

# ==================================================================
# Phase 2 -- Multi-Horizon Architecture (LONG_TERM alongside INTRADAY)
# ==================================================================
# Everything below tunes the fundamentals-driven LONG_TERM engine that
# runs ALONGSIDE the intraday engine above -- for any ticker tagged
# LONG_TERM or DUAL_HORIZON via the dashboard's "Tracked tickers"
# horizon selector (talonx_watchlist, README §5n). Nothing below is
# required; a fresh install with no LONG_TERM-tagged tickers behaves
# exactly like Phase 1 (these components stay idle, no errors).

# --- talonx_quant -- fundamental factor scanner (ROIC / Piotroski F-Score) ---
# TALONX_REDIS_FUNDAMENTALS_CHANNEL=talonx:fundamentals:events
# TALONX_REDIS_FUNDAMENTAL_SIGNALS_CHANNEL=talonx:signals:fundamental
# Spec's example thresholds: ROIC >= 15%, F-Score >= 7/9.
# TALONX_QUANT_ROIC_THRESHOLD=0.15
# TALONX_QUANT_F_SCORE_THRESHOLD=7
# Own cooldown key namespace (fundamental_cooldown:{TICKER}), NOT the
# intraday cooldown -- default ~7 days (filings don't repeat within a quarter).
# TALONX_QUANT_FUNDAMENTAL_COOLDOWN_SECONDS=604800.0

# --- talonx_brain -- moat/DCF research (reuses the LLM provider configured above) ---
# TALONX_REDIS_REPORTS_LONG_TERM_CHANNEL=talonx:reports:longterm
# 90-day flat cap, no market-hours boundary math -- also invalidated the
# moment a fresh filing OR fresh structured financials arrive for that ticker.
# TALONX_BRAIN_CACHE_BASE_TTL_LONG_TERM=7776000.0

# --- talonx_core -- long-term decision matrix (HIGH_CONVICTION_BUY / HOLD_QUALITY / TAKE_PROFIT_REBALANCE / UNDER_PERFORM_REBALANCE) ---
# TALONX_REDIS_ALERTS_LONG_TERM_CHANNEL=talonx:alerts:longterm
# Quality Score >= 7/10, Margin of Safety >= 20% (price <= 0.8x fair
# value), overvaluation trim at a 20% premium (price > 1.2x fair value).
# TALONX_CORE_LT_QUALITY_SCORE_MIN=7
# TALONX_CORE_LT_MARGIN_OF_SAFETY_PCT=0.20
# TALONX_CORE_LT_VALUATION_PREMIUM_PCT=0.20
# No beta/market-risk-premium data source exists anywhere in this project
# to compute a real CAPM-based WACC -- used as a documented assumed
# constant instead (roughly the long-run US equity market average).
# TALONX_CORE_LT_ASSUMED_WACC=0.09
# Fundamental-stop trigger: 2 consecutive quarters of ROIC < WACC, OR
# Debt/EBITDA above this (EBITDA proxied by operating income -- no
# separate D&A line exists in the parsed XBRL facts; see README §9).
# TALONX_CORE_LT_MAX_DEBT_TO_EBITDA=4.0
# ~1 fiscal year -- annual (10-K-only) facts can't arrive more often.
# TALONX_CORE_LT_CORRELATION_WINDOW=34560000.0
# ~1 month -- long-term alerts intentionally repeat far less often than
# intraday ones.
# TALONX_CORE_LT_TICKER_COOLDOWN=2592000.0
# Wider than the intraday 1% default -- long-term valuation bands are
# inherently coarser.
# TALONX_CORE_LT_PRICE_DELTA_RETRIGGER_PCT=0.05

# --- talonx_paper -- DCA-aware long-term paper ledger (Module 6's sibling) ---
# A SEPARATE cash pool from the intraday portfolio above (see README §3.6) --
# fresh-install default only, same "dashboard Reset button to actually
# apply a new value" caveat as TALONX_PAPER_INITIAL_BALANCE.
# TALONX_REDIS_PAPER_TRADES_LONG_TERM_CHANNEL=talonx:paper:trades:longterm
# TALONX_PAPER_LT_INITIAL_BALANCE=20000.0
# The opening HIGH_CONVICTION_BUY's position size -- separate from the
# recurring DCA contribution below, which only ever tops up an
# ALREADY-open position.
# TALONX_PAPER_LT_INITIAL_POSITION=2000.0
# TALONX_PAPER_DCA_CONTRIBUTION=500.0
# Fixed-interval approximation of "monthly" -- not true calendar-month
# scheduling (documented simplification).
# TALONX_PAPER_DCA_INTERVAL_DAYS=30.0
# Fraction of the position trimmed on a TAKE_PROFIT_REBALANCE alert.
# TALONX_PAPER_REBALANCE_TRIM_PCT=0.33

# --- run_talonx.py -- slow daily-close price poll for LONG_TERM-only tickers ---
# A DUAL_HORIZON ticker already gets a price stream from Module 1's
# regular continuous feed above -- this is only for tickers tagged
# LONG_TERM with no intraday coverage, so margin-of-safety math still
# has a current price without minute-bar technical scanning.
# TALONX_LT_PRICE_POLL_INTERVAL=86400.0

# --- Event-Driven Earnings Radar (README §3.2/§3.5, Requirements 4-9) ---
# Moves LONG_TERM evaluation from quarterly-cadence-only to an active
# earnings lifecycle: weekly calendar sync -> T-48h heads-up push ->
# fast-tracked 8-K/10-Q ingestion on the earnings date -> a two-stage
# valuation recalculation -> a post-earnings Telegram push. Every knob
# below has a working default; nothing here is required.

# Weekly (default) yfinance earnings-calendar sync -- writes into
# talonx_watchlist's upcoming_earnings table for every LONG_TERM/
# DUAL_HORIZON ticker. NOT anchored to actual wall-clock Sunday-00:00-UTC
# (this codebase has no day-of-week scheduling precedent) -- "weekly"
# here means every N hours from process start, default 168 (7 days).
# TALONX_INGEST_EARNINGS_SYNC_INTERVAL_HOURS=168.0

# talonx_dispatch's T-48h pre-earnings heads-up push -- bypasses ALL
# standard dispatch suppression (severity gate, cooldowns) by design,
# same "always send" precedent trade-execution pushes already use.
# TALONX_DISPATCH_EARNINGS_HEADS_UP_CHECK_HOURS=24.0
# TALONX_DISPATCH_EARNINGS_HEADS_UP_WINDOW_HOURS=48.0

# run_talonx.py's EarningsFastTrackPoller -- for a ticker currently inside
# its active earnings window (flat 2-calendar-day span around the known
# date; session-aware Before/After-Market windowing is skipped, since
# yfinance's session data isn't reliable enough to window precisely
# against), polls EDGAR for 8-K/10-Q every N seconds (default 900 = 15
# min) and captures an extended-hours (prepost=True) price quote.
# TALONX_EARNINGS_FAST_TRACK_POLL_SECONDS=900.0

# talonx_quant.fundamental_consumer's Stage 1 (8-K) republish -- reuses
# PERSISTED factors (talonx_quant/store.py's latest_fundamental_factors
# table) rather than fresh XBRL (not available until the 10-Q lands).
# Deliberately its OWN short-TTL cooldown namespace
# (earnings_republish_cooldown:{TICKER}), NOT the standard 7-day
# TALONX_QUANT_FUNDAMENTAL_COOLDOWN_SECONDS above -- a duplicate/amended
# 8-K shouldn't re-fire the pipeline twice within the same hour, but this
# must not be blocked by (or block) the unrelated routine cooldown.
# TALONX_QUANT_EARNINGS_REPUBLISH_COOLDOWN_SECONDS=3600.0

# Same env var talonx_brain/talonx_core already read on their own sides
# of this boundary -- talonx_quant now ALSO subscribes to it (Stage 1's
# 8-K trigger), reusing the existing channel rather than adding a new one.
# TALONX_REDIS_FILINGS_CHANNEL=talonx:filings:events

# CLI-only (not env vars): --skip-earnings-sync and
# --skip-earnings-fast-track on run_talonx.py disable the weekly sync
# loop / fast-track poller respectively while leaving the rest of the
# Earnings Radar (and Phase 2 generally) running.
