# Copy this file to .env in this same folder (the repo root) and fill in
# the REQUIRED section. Everything else is optional tuning with sane
# defaults -- see README.md §7 for the full rationale behind each one.

# ------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------
# SEC requires a descriptive User-Agent identifying who is making
# requests. Format: "Name/Company contact@email.com". Missing or
# generic values will get you 403'd or throttled harder.
TALONX_SEC_USER_AGENT="Your Name Your Company your.email@example.com"

# ------------------------------------------------------------------
# OPTIONAL -- EDGAR rate limiting / retry tuning
# ------------------------------------------------------------------
# TALONX_SEC_RPS=8.0
# TALONX_SEC_CONCURRENCY=4
# TALONX_SEC_MAX_RETRIES=5
# TALONX_SEC_BACKOFF_BASE=1.5
# TALONX_SEC_BACKOFF_MAX=60.0
# TALONX_SEC_TIMEOUT=30.0
# TALONX_SEC_LOOKBACK=4

# ------------------------------------------------------------------
# OPTIONAL -- chunking
# ------------------------------------------------------------------
# TALONX_CHUNK_SIZE=1800
# TALONX_CHUNK_OVERLAP=250
# TALONX_MIN_CHUNK_CHARS=40

# ------------------------------------------------------------------
# OPTIONAL -- vector store / embeddings
# ------------------------------------------------------------------
# TALONX_CHROMA_DIR=C:\Users\you\.talonx\chroma
# TALONX_CHROMA_COLLECTION=sec_filings
# TALONX_EMBEDDING_MODEL=all-MiniLM-L6-v2
# TALONX_CHROMA_BATCH_SIZE=128

# ------------------------------------------------------------------
# OPTIONAL -- raw filing cache / ledger
# ------------------------------------------------------------------
# TALONX_RAW_CACHE_DIR=C:\Users\you\.talonx\raw_filings
# TALONX_LEDGER_PATH=C:\Users\you\.talonx\ledger.db

# ------------------------------------------------------------------
# OPTIONAL -- market data (structured/quant side)
# ------------------------------------------------------------------
# Without this set, market_data automatically uses yfinance polling
# instead of Polygon WebSocket streaming (delayed data, not real-time,
# but requires no account/key).
# POLYGON_API_KEY=your_polygon_io_api_key

# TALONX_POLYGON_WS_URL=wss://socket.polygon.io/stocks
# TALONX_WS_MAX_RECONNECT=8
# TALONX_WS_BACKOFF_BASE=1.0
# TALONX_WS_BACKOFF_MAX=30.0
# TALONX_WS_AUTH_TIMEOUT=10.0
# TALONX_WS_IDLE_TIMEOUT=60.0
# TALONX_YF_POLL_INTERVAL=5.0
# TALONX_YF_MAX_RETRIES=3
# TALONX_YF_BACKOFF_BASE=2.0
# TALONX_YF_BACKOFF_MAX=30.0

# ------------------------------------------------------------------
# OPTIONAL -- talonx_quant indicator thresholds
# ------------------------------------------------------------------
# TALONX_QUANT_RSI_PERIOD=14
# TALONX_QUANT_RSI_OVERSOLD=30
# TALONX_QUANT_RSI_OVERBOUGHT=70
# TALONX_QUANT_MACD_FAST=12
# TALONX_QUANT_MACD_SLOW=26
# TALONX_QUANT_MACD_SIGNAL=9
# TALONX_QUANT_MA_FAST=50
# TALONX_QUANT_MA_SLOW=200
# TALONX_QUANT_VOLUME_AVG_PERIOD=20
# TALONX_QUANT_VOLUME_SURGE_RATIO=2.0
# TALONX_QUANT_MIN_BARS=50
# TALONX_QUANT_MAX_BARS=500
# TALONX_QUANT_RECONNECT_BASE=1.0
# TALONX_QUANT_RECONNECT_MAX=30.0

# ------------------------------------------------------------------
# OPTIONAL -- Redis Pub/Sub (event publishing + inter-module wire contract)
# ------------------------------------------------------------------
# Without Redis reachable, ingestion and streaming still work normally --
# only the live event broadcast is disabled (logged once, not fatal).
TALONX_REDIS_URL=redis://localhost:6379/0
# TALONX_REDIS_MARKET_CHANNEL=talonx:market:stream
# TALONX_REDIS_FILINGS_CHANNEL=talonx:filings:events
# TALONX_REDIS_SIGNALS_CHANNEL=talonx:signals:quant
# TALONX_REDIS_REPORTS_CHANNEL=talonx:reports:brain
# TALONX_REDIS_ALERTS_CHANNEL=talonx:alerts:dispatch
# TALONX_REDIS_CONNECT_TIMEOUT=5.0
# TALONX_REDIS_SOCKET_TIMEOUT=5.0

# ------------------------------------------------------------------
# OPTIONAL -- news/social feed ingestion
# ------------------------------------------------------------------
# Without this set, news ingestion automatically uses the Yahoo Finance
# RSS fallback instead of NewsAPI.org (no key required, fewer/less-tunable
# results).
# NEWS_API_KEY=your_newsapi_org_key

# TALONX_NEWS_ARTICLES_PER_TICKER=20
# TALONX_NEWS_LOOKBACK_DAYS=7
# TALONX_NEWS_RSS_TEMPLATE=https://feeds.finance.yahoo.com/rss/2.0/headline?s={symbol}&region=US&lang=en-US
# TALONX_NEWS_MAX_RETRIES=3
# TALONX_NEWS_BACKOFF_BASE=1.5
# TALONX_NEWS_BACKOFF_MAX=30.0
# TALONX_NEWS_TIMEOUT=15.0
# TALONX_NEWS_CHROMA_COLLECTION=news_feed

# Reddit as an additional news/social source (optional -- see README §4
# for how to create a Reddit app; NewsAPI/RSS above already work without it)
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
# REDDIT_USER_AGENT="TalonX Research Engine by /u/your_reddit_username"
# TALONX_REDDIT_SUBREDDITS=stocks,investing,wallstreetbets
# TALONX_REDDIT_POSTS_PER_TICKER=20
# TALONX_REDDIT_LOOKBACK_DAYS=7
# TALONX_REDDIT_RPM=60
# TALONX_REDDIT_MAX_RETRIES=3
# TALONX_REDDIT_BACKOFF_BASE=1.5
# TALONX_REDDIT_BACKOFF_MAX=30.0
# TALONX_REDDIT_TIMEOUT=15.0

# ------------------------------------------------------------------
# talonx_brain (Module 3) -- LLM provider switch (README §3.3, §9.4)
# ------------------------------------------------------------------
# Pick ONE provider:
#
# Option A -- Gemini (default, cloud). Get a key from
# https://aistudio.google.com/apikey. Free tier has both per-minute AND
# per-day quotas that are easy to exhaust under active testing (§9.2).
# GEMINI_API_KEY=your_gemini_api_key
# TALONX_BRAIN_GEMINI_MODEL=gemini-flash-latest
# TALONX_BRAIN_GEMINI_TEMPERATURE=0.2
# TALONX_BRAIN_GEMINI_MAX_TOKENS=2048
# TALONX_BRAIN_GEMINI_MAX_RETRIES=3
# TALONX_BRAIN_GEMINI_BACKOFF_BASE=2.0
# TALONX_BRAIN_GEMINI_BACKOFF_MAX=30.0
# TALONX_BRAIN_GEMINI_RPM=5

# Option B -- Ollama (local, no key/quota). Install from ollama.com,
# `ollama pull llama3.1`, then uncomment:
# TALONX_BRAIN_LLM_PROVIDER=ollama
# TALONX_BRAIN_OLLAMA_BASE_URL=http://localhost:11434
# TALONX_BRAIN_OLLAMA_MODEL=llama3.1
# TALONX_BRAIN_OLLAMA_TEMPERATURE=0.2
# TALONX_BRAIN_OLLAMA_MAX_RETRIES=3
# TALONX_BRAIN_OLLAMA_BACKOFF_BASE=2.0
# TALONX_BRAIN_OLLAMA_BACKOFF_MAX=30.0

# TALONX_BRAIN_RETRIEVAL_TOP_K=6
# TALONX_BRAIN_EXCERPT_MAX_CHARS=600
# TALONX_BRAIN_INCLUDE_NEWS=true
# TALONX_BRAIN_NEWS_TOP_K=3
# TALONX_BRAIN_RECONNECT_BASE=1.0
# TALONX_BRAIN_RECONNECT_MAX=30.0

# Qualitative research caching (README §3.3) -- cuts repeat Gemini/Ollama
# calls for the same ticker. TALONX_REDIS_FILINGS_CHANNEL (already
# defined above under talonx_ingest) is reused here too, no separate var.
# TALONX_BRAIN_CACHE_ENABLED=true
# TALONX_BRAIN_CACHE_BASE_TTL=7200
# TALONX_BRAIN_CACHE_SAFETY_TTL=21600
# TALONX_BRAIN_CACHE_LOCK_TTL=30
# TALONX_BRAIN_CACHE_LOCK_WAIT_SECONDS=20
# TALONX_BRAIN_MARKET_TZ=America/New_York
# TALONX_BRAIN_MARKET_OPEN_HOUR=9
# TALONX_BRAIN_MARKET_CLOSE_HOUR=16

# ------------------------------------------------------------------
# talonx_core (Module 4) -- decision engine tuning
# ------------------------------------------------------------------
# TALONX_CORE_MIN_CONFIDENCE=0.5
# TALONX_CORE_CORRELATION_WINDOW=1800
# TALONX_CORE_TICKER_COOLDOWN=300
# TALONX_CORE_PRICE_DELTA_RETRIGGER_PCT=0.01
# TALONX_CORE_ENABLE_PERSISTENCE=true
# TALONX_CORE_STATE_DB=C:\Users\you\.talonx\core_state.db
# TALONX_CORE_RECONNECT_BASE=1.0
# TALONX_CORE_RECONNECT_MAX=30.0

# ------------------------------------------------------------------
# talonx_dispatch (Module 5) -- Telegram push + Streamlit dashboard
# ------------------------------------------------------------------
# Optional -- without it, alerts are still recorded to the audit trail
# and shown in the Streamlit dashboard, you just don't get a mobile push.
# See README §4 for the @BotFather setup steps.
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# TALONX_DISPATCH_MIN_SEVERITY=warning
# TALONX_DISPATCH_AUDIT_DB=C:\Users\you\.talonx\dispatch_audit.db
# TALONX_DISPATCH_FEED_LIMIT=200
# TALONX_DISPATCH_AUTOREFRESH_MS=5000
# TALONX_DISPATCH_RECONNECT_BASE=1.0
# TALONX_DISPATCH_RECONNECT_MAX=30.0
# TALONX_DISPATCH_TELEGRAM_MAX_RETRIES=3
# TALONX_DISPATCH_TELEGRAM_BACKOFF_BASE=2.0
# TALONX_DISPATCH_TELEGRAM_BACKOFF_MAX=30.0

# ------------------------------------------------------------------
# Ticker watchlist (talonx_watchlist) -- see README §5n
# ------------------------------------------------------------------
# Which tickers run_talonx.py streams market data for and periodically
# ingests filings/news for. Managed live via the "Tracked tickers"
# section of the Streamlit dashboard (talonx_dispatch/app.py) -- these
# vars only control the store's location and the fresh-install default.
# TALONX_WATCHLIST_DB=C:\Users\you\.talonx\watchlist.db
# TALONX_WATCHLIST_DEFAULT_SYMBOL=MSFT
# TALONX_WATCHLIST_DEFAULT_NAME=Microsoft Corporation
# TALONX_WATCHLIST_DEFAULT_EXCHANGE=NASDAQ
# TALONX_WATCHLIST_POLL_INTERVAL=10.0
